{
  "name": "fluent-emoji-picker",
  "private": true,
  "license": "MIT-0",
  "type": "module",
  "imports": {
    "#components/*": "./components/*",
    "#config/*": "./config/*",
    "#hooks/*": "./hooks/*",
    "#lib/*": "./lib/*",
    "#styles/*": "./styles/*"
  },
  "scripts": {
    "assets:build": "bun scripts/build-emoji-atlases.ts",
    "assets:update": "bun scripts/update-emoji-list.ts && bun run assets:build",
    "licenses:build": "bun scripts/build-licenses.ts",
    "dev": "bun run licenses:build && bun --bun vite dev",
    "build": "vite build",
    "deploy:check": "cf deploy --prebuilt --mode production --dry-run",
    "deploy": "cf deploy --prebuilt --mode production",
    "preview": "vite preview",
    "format": "bun fmt",
    "format:check": "bun fmt",
    "lint": "bun lint --max-warnings 0",
    "lint:fix": "bun lint --fix --max-warnings 0",
    "typecheck": "bun check && bun check -p scripts/tsconfig.json",
    "check": "bun run format:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.70.0",
    "nuqs": "2.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "skullet": "0.0.3",
    "vinext": "1.4.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "cf": "1.0.0-beta.28",
    "oxc-transform-react": "0.158.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "unplugin-license": "0.2.0",
    "vite": "8.3.7"
  }
}
